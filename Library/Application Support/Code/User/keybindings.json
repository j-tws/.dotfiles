// Place your key bindings in this file to override the defaults
[
  {
    "command": "extension.runLineOnRspec",
    "key": "cmd+l",
    "when": "editorLangId == 'ruby'"
  },
  {
    "key": "cmd+o",
    "command": "extension.advancedOpenFile"
  },
  {
    "key": "cmd+m",
    "command": "editor.action.selectToBracket"
  },
  // move several lines up
  {
    "key": "ctrl+up", 
    "command": "cursorMove",
    "args": {
        "to": "up",
        "by": "line",
        "value": 10         // change this if you want
    },
    "when": "editorTextFocus"
  },
  // move several lines down
  {
      "key": "ctrl+down",
      "command": "cursorMove",
      "args": {
          "to": "down",
          "by": "line",
          "value": 10         // change
      },
      "when": "editorTextFocus"
  },
  // scroll window without moving cursor
  {
    "key": "shift+ctrl+up",
    "command": "multiCommand.up1LineKeepCursor",
    "when": "editorTextFocus"
  },
  {
    "key": "shift+ctrl+down",
    "command": "multiCommand.down1LineKeepCursor",
    "when": "editorTextFocus"
  },
  // copy relative path of a file
  {
    "key": "cmd+alt+c",
    "command": "copyRelativeFilePath",
    "when": "editorFocus"
  },
  {
    "key": "ctrl+alt+.",
    "command": "workbench.action.positionPanelRight"
  },
  {
    "key": "ctrl+alt+,",
    "command": "workbench.action.positionPanelBottom"
  },
  {
      "key": "shift+enter",
      "command": "workbench.action.terminal.sendSequence",
      "args": {
          "text": "\\\r\n"
      },
      "when": "terminalFocus"
  },
  {
    // run all tests in current test file
    "key": "cmd+alt+l",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "bundle exec rspec ${relativeFile}\u000D" }
  },
  {
    // Run test at current line
    "key": "cmd+l",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "bundle exec rspec ${relativeFile}:${lineNumber}\u000D" }
  }
]